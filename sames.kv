#:import get_color_from_hex kivy.utils.get_color_from_hex
#:import md_icons kivymd.icon_definitions.md_icons
#:import FadeTransition kivy.uix.screenmanager.FadeTransition
#:import dp kivy.metrics.dp

<StyledCard@MDCard>:
    md_bg_color: get_color_from_hex('#FFFFFF')
    ripple_color: app.theme_cls.primary_color
    radius: [dp(10)]
    elevation: 3

<BaseScreen>:
    #:import get_color_from_hex kivy.utils.get_color_from_hex
    canvas.before:
        Color:
            rgba: get_color_from_hex('#F5F5F5')
        Rectangle:
            pos: self.pos
            size: self.size

<LoginScreen>:
    MDBoxLayout:
        orientation: 'vertical'
        padding: dp(20)
        spacing: dp(20)
        
        Widget:
            size_hint_y: 0.1
            
        MDBoxLayout:
            orientation: 'vertical'
            spacing: dp(10)
            size_hint_y: 0.4
            pos_hint: {'center_x': 0.5, 'center_y': 0.5}
            
            MDLabel:
                text: 'SAMEs'
                halign: 'center'
                font_style: 'H3'
                theme_text_color: "Primary"
                
            MDLabel:
                text: "SAMEs : système d'alerte de maintenance par l'employé"
                halign: 'center'
                theme_text_color: "Secondary"
                font_style: 'Body2'
        
        StyledCard:
            orientation: 'vertical'
            padding: dp(20)
            spacing: dp(20)
            size_hint: 0.9, None
            height: self.minimum_height
            pos_hint: {'center_x': 0.5}
            
            MDTextField:
                id: matricule
                hint_text: "Matricule"
                helper_text: "Entrez votre matricule"
                helper_text_mode: "on_error"
                size_hint_x: 1
                font_size: '18sp'
                
            MDTextField:
                id: password
                hint_text: "Mot de passe (Technicien uniquement)"
                helper_text: "Requis pour les techniciens"
                helper_text_mode: "on_error"
                password: True
                size_hint_x: 1
                font_size: '18sp'
                
            MDFillRoundFlatButton:
                text: "Se connecter"
                size_hint_x: 1
                font_size: '18sp'
                on_release: root.verify_login()
        
        Widget:
            size_hint_y: 0.2

<EmployeeCameraScreen>:
    MDBoxLayout:
        orientation: 'vertical'
        spacing: dp(10)
        
        MDTopAppBar:
            title: "Capture d'anomalie"
            right_action_items: [["logout", lambda x: app.logout()]]
            elevation: 2
            
        MDBoxLayout:
            orientation: 'vertical'
            padding: dp(20)
            spacing: dp(20)
            
            StyledCard:
                id: camera_layout
                size_hint_y: 0.7
                radius: [dp(10)]
                elevation: 3
            
            MDFillRoundFlatIconButton:
                text: "Prendre une photo"
                icon: "camera"
                font_size: '18sp'
                size_hint_x: 0.8
                pos_hint: {'center_x': 0.5}
                on_release: root.capture_photo()

<AlertTypeScreen>:
    MDBoxLayout:
        orientation: 'vertical'
        spacing: dp(10)
        
        MDTopAppBar:
            title: "Type d'anomalie"
            left_action_items: [["arrow-left", lambda x: setattr(app.root, 'current', 'employee_camera')]]
            right_action_items: [["logout", lambda x: app.logout()]]
            elevation: 2
            
        ScrollView:
            do_scroll_x: False
            
            MDGridLayout:
                id: type_grid
                cols: 2
                padding: dp(20)
                spacing: dp(20)
                size_hint_y: None
                height: self.minimum_height
                
                StyledCard:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: dp(180)
                    radius: [dp(10)]
                    elevation: 3
                    on_release: root.select_type('Fuite')
                    
                    MDIcon:
                        icon: 'water'
                        font_size: dp(64)
                        halign: 'center'
                        theme_text_color: "Primary"
                        
                    MDLabel:
                        text: 'Fuite'
                        halign: 'center'
                        font_style: 'H6'
                        
                StyledCard:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: dp(180)
                    radius: [dp(10)]
                    elevation: 3
                    on_release: root.select_type('Usure')
                    
                    MDIcon:
                        icon: 'wrench'
                        font_size: dp(64)
                        halign: 'center'
                        theme_text_color: "Primary"
                        
                    MDLabel:
                        text: 'Usure'
                        halign: 'center'
                        font_style: 'H6'
                        
                StyledCard:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: dp(180)
                    radius: [dp(10)]
                    elevation: 3
                    on_release: root.select_type('Déformation')
                    
                    MDIcon:
                        icon: 'alert-octagon'
                        font_size: dp(64)
                        halign: 'center'
                        theme_text_color: "Primary"
                        
                    MDLabel:
                        text: 'Déformation'
                        halign: 'center'
                        font_style: 'H6'

<AlertStatusScreen>:
    MDBoxLayout:
        orientation: 'vertical'
        spacing: dp(10)
        
        MDTopAppBar:
            title: "Statut de l'alerte"
            right_action_items: [["logout", lambda x: app.logout()]]
            elevation: 2
            
        MDBoxLayout:
            orientation: 'vertical'
            padding: dp(20)
            spacing: dp(20)
            
            StyledCard:
                orientation: 'vertical'
                padding: dp(20)
                spacing: dp(10)
                size_hint: 0.9, None
                height: self.minimum_height
                pos_hint: {'center_x': 0.5}
                
                MDIcon:
                    id: status_icon
                    icon: 'clock-outline'
                    font_size: dp(64)
                    halign: 'center'
                    theme_text_color: "Custom"
                    text_color: 1, 0.8, 0, 1
                    
                MDLabel:
                    id: status_label
                    text: "Statut: En attente"
                    halign: 'center'
                    font_style: 'H5'
                    theme_text_color: "Primary"

<TechnicianDashboardScreen>:
    MDBoxLayout:
        orientation: 'vertical'
        spacing: dp(10)
        
        MDTopAppBar:
            title: "Tableau de bord technicien"
            left_action_items: [["menu", lambda x: app.toggle_nav_drawer()]]
            right_action_items: [["refresh", lambda x: root.load_alerts()], ["logout", lambda x: app.logout()]]
            elevation: 2
            
        ScrollView:
            do_scroll_x: False
            
            MDGridLayout:
                id: alerts_grid
                cols: 1
                padding: dp(20)
                spacing: dp(20)
                size_hint_y: None
                height: self.minimum_height
                adaptive_height: True

ScreenManager:
    id: screen_manager
    transition: FadeTransition(duration=0.25)
    
    LoginScreen:
        name: 'login'
    EmployeeCameraScreen:
        name: 'employee_camera'
    AlertTypeScreen:
        name: 'alert_type'
    AlertStatusScreen:
        name: 'alert_status'
    TechnicianDashboardScreen:
        name: 'technician_dashboard'
